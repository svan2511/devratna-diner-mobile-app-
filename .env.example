# Copy to .env for local dev. Never commit real keys.
# Phone se local backend: use your computer's LAN IP (same Wi-Fi), not localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api/v1

# Exact shop pin (must match backend SHOP_LAT / SHOP_LNG).
EXPO_PUBLIC_SHOP_LAT=30.2710150
EXPO_PUBLIC_SHOP_LNG=77.9926317

# Google Maps SDK for Android key (build-time only, not EXPO_PUBLIC).
GOOGLE_MAPS_API_KEY=your-google-maps-android-key
